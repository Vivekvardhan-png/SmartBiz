# ============================================================
# SmartBiz — Backend Environment Variables
# Copy this file to .env in the backend/ directory and fill in
# real values before running locally. NEVER commit a .env file
# with real credentials to version control.
# ============================================================

# --- PostgreSQL Connection ---
DB_URL=jdbc:postgresql://localhost:5432/smartbiz_dev
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_LOCAL_ONLY

# --- CORS ---
# Comma-separated list of frontend origins allowed to call the API.
# Wildcard (*) is not permitted.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- JWT Authentication (Prompt 02) ---
# Must be at least 32 characters (256-bit) high-entropy secret.
# Generate locally with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_CHARS_RANDOM_SECRET
JWT_EXPIRATION_SECONDS=3600

# --- Optional Python Forecasting Service (Prompt 06) ---
FORECASTING_ENABLED=false
FORECASTING_URL=http://localhost:8001
FORECASTING_API_KEY=CHANGE_ME_LOCAL_INTERNAL_KEY

# --- Controlled AI Assistant & Automation (Prompt 07) ---
# Keep API keys strictly on the backend. Never put provider keys in frontend/.env.
AI_ASSISTANT_ENABLED=false
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=CHANGE_ME_LOCAL_OPENAI_KEY
AI_MODEL=gpt-4o-mini
AI_RATE_LIMIT_PER_MINUTE=20
AUTOMATION_SCHEDULER_ENABLED=false
